    "test:live": "vitest run --config live/vitest.live.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "filesystem-kit": "^3.1.0",
    "zod": "^3.24.0"
  }
}
